---
import FlashcardCollection from "@/components/flashcards/FlashcardCollection";
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Flashcard collection">
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-medium text-blue-200">10xCards</p>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Your collection
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">Signed in as {user?.email}</p>
        </div>
        <div class="flex items-center gap-3">
          <nav aria-label="Dashboard navigation">
            <a
              href="/dashboard"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:outline-none"
            >
              AI workspace
            </a>
            <span class="sr-only" aria-current="page">Collection</span>
          </nav>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:outline-none"
            >
              Sign out
            </button>
          </form>
        </div>
      </header>

      <FlashcardCollection client:load />
    </div>
  </main>
</Layout>
