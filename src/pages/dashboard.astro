---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import FlashcardWorkspace from "@/components/flashcards/FlashcardWorkspace";
import { aiConfigStatus } from "@/lib/config-status";

const { user } = Astro.locals;
---

<Layout title="AI flashcard workspace">
  {!aiConfigStatus.configured && <Banner variant="warning">{aiConfigStatus.message}</Banner>}
  <main class="bg-cosmic min-h-screen px-4 py-8 text-white sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-medium text-blue-200">10xCards</p>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            AI flashcard workspace
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">Signed in as {user?.email}</p>
        </div>
        <div class="flex items-center gap-3">
          <nav aria-label="Dashboard navigation">
            <a
              href="/dashboard/review"
              class="mr-3 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:outline-none"
            >
              Review
            </a>
            <a
              href="/dashboard/collection"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:outline-none"
            >
              Collection
            </a>
          </nav>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:outline-none"
            >
              Sign out
            </button>
          </form>
        </div>
      </header>

      <FlashcardWorkspace client:load aiConfigured={aiConfigStatus.configured} />
    </div>
  </main>
</Layout>
